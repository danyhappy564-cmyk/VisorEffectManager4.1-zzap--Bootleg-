<Project>

  <!--
    Where the SPT install lives. Override with -p:SptRoot=... or an SptRoot
    environment variable. TarkovDir is kept as an alias for anyone who was
    already passing the old property name.
  -->
  <PropertyGroup>
    <SptRoot Condition=" '$(SptRoot)' == '' AND '$(TarkovDir)' != '' ">$(TarkovDir)</SptRoot>
    <SptRoot Condition=" '$(SptRoot)' == '' ">E:\SPT 4.1</SptRoot>
    <SptManaged>$(SptRoot)\EscapeFromTarkov_Data\Managed</SptManaged>
    <SptBepInEx>$(SptRoot)\BepInEx</SptBepInEx>
  </PropertyGroup>

</Project>
