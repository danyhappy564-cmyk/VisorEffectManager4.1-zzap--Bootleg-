<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>
		<RootNamespace>VisorEffectManager</RootNamespace>
		<AssemblyName>VisorEffectManager</AssemblyName>
		<Version>2.0.0</Version>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>


	<ItemGroup>
		<!-- BepInEx Core -->
		<Reference Include="0Harmony">
			<HintPath>$(SptBepInEx)\core\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="BepInEx">
			<HintPath>$(SptBepInEx)\core\BepInEx.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!-- SPT -->
		<Reference Include="spt-reflection">
			<HintPath>$(SptBepInEx)\plugins\spt\spt-reflection.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="spt-common">
			<HintPath>$(SptBepInEx)\plugins\spt\spt-common.dll</HintPath>
		</Reference>

		<!-- Tarkov Game -->
		<Reference Include="Assembly-CSharp">
			<HintPath>$(SptManaged)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Comfort">
			<HintPath>$(SptManaged)\Comfort.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Comfort.Unity">
			<HintPath>$(SptManaged)\Comfort.Unity.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
			<SpecificVersion>False</SpecificVersion>
			<HintPath>$(SptManaged)\Newtonsoft.Json.dll</HintPath>
		</Reference>

		<!-- Unity -->
		<Reference Include="UnityEngine">
			<HintPath>$(SptManaged)\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(SptManaged)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(SptManaged)\UnityEngine.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Sirenix.Serialization">
			<HintPath>$(SptManaged)\Sirenix.Serialization.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(SptManaged)\Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(SptManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="PhysicsModule">
			<HintPath>$(SptManaged)\UnityEngine.PhysicsModule.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!-- Drop the built plugin straight into BepInEx\plugins. -->
	<Target Name="DeployToSpt" AfterTargets="Build" Condition=" '$(DeployToSpt)' != 'false' AND Exists('$(SptBepInEx)') ">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptBepInEx)\plugins" />
		<Message Importance="high" Text="Deployed $(TargetFileName) to $(SptBepInEx)\plugins" />
	</Target>

</Project>


